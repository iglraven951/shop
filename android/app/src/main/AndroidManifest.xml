<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- El sitio va dentro de la APK, así que la app arranca y funciona sin
         conexión. Internet hace falta para dos cosas concretas: las teselas
         del mapa (tile.openstreetmap.org) y las fotos de demostración. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 11+ oculta el resto de apps instaladas salvo que se declaren
         las intenciones que se van a resolver. Sin esto, el enlace de
         WhatsApp del panel de administración no encontraría a nadie.

         La lista tiene que cubrir exactamente los esquemas que NativeBridge
         acepta: si el puente deja pasar `tel:` pero aquí no se declara, la
         llamada sale del WebView y muere en un aviso de «no encontramos una
         app», que es peor que no haberlo ofrecido. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- El selector de archivos: sin esto `onShowFileChooser` no
             encontraría ninguna app de galería o de documentos. -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DiscoveryShop">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DiscoveryShop.Starter"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Un enlace al foro abre el foro.

                 El sitio existe en dos sitios a la vez —GitHub Pages y esta
                 APK— y comparten las mismas rutas, así que la URL que alguien
                 comparte desde la app es exactamente la que un navegador sabe
                 abrir. `autoVerify` hace que, si el dominio confirma la
                 asociación, Android deje de preguntar y abra la app directa;
                 si no la confirma, sigue apareciendo el selector de siempre.
                 En ningún caso se rompe el enlace. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="iglraven951.github.io"
                    android:pathPrefix="/shop/"
                    android:scheme="https" />
            </intent-filter>

            <!-- Esquema propio: no depende de ningún dominio ni de que la
                 verificación salga bien, así que es el que se puede usar con
                 total confianza desde otra app o desde un QR. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="discoveryshop" />
            </intent-filter>

            <!-- Accesos directos del lanzador. Son los mismos tres que el
                 sitio ya declara en site.webmanifest para su instalación como
                 PWA; tenerlos aquí es lo que hace que la app no ofrezca menos
                 que la página web. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

    </application>

</manifest>
