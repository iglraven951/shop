<?xml version="1.0" encoding="utf-8"?>
<!--
    Silueta plana para los iconos tematizados de Android 13+.
    Misma geometria que ic_launcher_foreground, pero sin variacion de alfa:
    el sistema aplica su propio tinte. El hueco de la lupa es geometria real
    (evenOdd), de modo que sobrevive al tintado.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.65"
        android:scaleY="1.65"
        android:translateX="19.69"
        android:translateY="25.54">

        <!-- Panel lateral, ahora opaco: se funde con el cuerpo -->
        <path
            android:pathData="M13.4,10.6 L9.1,29.4 a1.1,1.1 0 0 0 1.07,1.35 h3.23 Z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="1.0" />

        <!-- Asa -->
        <path
            android:pathData="M16.6,11.2 V9.4 a4.6,4.6 0 0 1 9.2,0 v1.8"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="1.0"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Cuerpo con la lupa recortada -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="1.0"
            android:fillType="evenOdd"
            android:pathData="M13.4,10.6 h15.9 a1.6,1.6 0 0 1 1.6,1.45 l1.62,17.1 a1.6,1.6 0 0 1 -1.6,1.75 H10.9 a1.1,1.1 0 0 1 -1.07,-1.35 Z M26.4571,22.9308 A6.25,6.25 0 1 0 24.8308,24.5571 L28.9868,28.7132 A1.15,1.15 0 0 0 30.6132,27.0868 Z M17.15,19.4 A4.15,4.15 0 1 0 25.45,19.4 A4.15,4.15 0 1 0 17.15,19.4 Z" />
    </group>
</vector>
