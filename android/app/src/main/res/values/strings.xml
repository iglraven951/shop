<?xml version="1.0" encoding="utf-8"?>
<!--
    Textos visibles de DiscoveryShop.

    Tono: el mismo del sitio web — cercano, en primera persona del plural
    («No pudimos…», «Vuelve a intentarlo…») y sin jerga técnica. El foro es de
    Arequipa, así que se usa el español peruano neutro y el tuteo.

    Todos los acentos y eñes van en UTF-8 literal, nunca como entidades.
-->
<resources>

    <!-- ===== Identidad ===== -->
    <string name="app_name">DiscoveryShop</string>

    <!--
        ===== Pantalla de sin conexión =====
        Solo se muestra cuando algo que de verdad necesita internet falla: el
        mapa de distritos y las fotos de demostración. El resto del foro vive
        en el localStorage del WebView y funciona igual sin cobertura, así que
        el mensaje lo dice explícitamente para que nadie crea que perdió sus
        publicaciones.
    -->
    <string name="error_offline_title">Sin conexión</string>
    <string name="error_offline_body">DiscoveryShop sigue funcionando sin internet: tus publicaciones, mensajes y guardados están en este teléfono. Solo el mapa de Arequipa necesita conexión para cargar.</string>
    <string name="error_offline_retry">Reintentar</string>

    <!-- ===== Acciones de la barra y del menú ===== -->
    <string name="action_share">Compartir</string>
    <string name="action_open_external">Abrir en el navegador</string>

    <!--
        Títulos de los Intent.createChooser(). Android los muestra encima de la
        lista de apps, así que son etiquetas cortas, no frases.
    -->
    <string name="chooser_open_with">Abrir con</string>
    <string name="chooser_share">Compartir publicación</string>

    <!-- ===== Avisos breves (toasts) ===== -->
    <!-- No hay navegador ni app que atienda el enlace (pasa con wa.me sin WhatsApp instalado). -->
    <string name="toast_no_browser">No encontramos una app para abrir este enlace</string>
    <string name="toast_link_copied">Enlace copiado</string>

    <!-- Doble atrás para salir, en lugar de un diálogo que corta la navegación. -->
    <string name="exit_confirm">Vuelve a pulsar atrás para salir</string>

    <!--
        ===== Accesos directos del lanzador =====
        Espejo exacto de los `shortcuts` de site.webmanifest: la web ya los
        prometía y la app tiene que ofrecer lo mismo. La etiqueta corta es la
        que cabe bajo el icono (una palabra); la larga es la que se lee en el
        menú contextual.
    -->
    <string name="shortcut_publish_short">Publicar</string>
    <string name="shortcut_publish_long">Publicar artículo</string>
    <string name="shortcut_map_short">Mapa</string>
    <string name="shortcut_map_long">Mapa de vendedores</string>
    <string name="shortcut_messages_short">Mensajes</string>
    <string name="shortcut_messages_long">Mis mensajes</string>

    <!-- Título del selector de archivos del WebView. -->
    <string name="chooser_pick_file">Elegir archivo</string>

</resources>
