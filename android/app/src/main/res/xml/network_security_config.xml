<?xml version="1.0" encoding="utf-8"?>
<!--
    Política de red de DiscoveryShop.

    PREMISA: la app no tiene servidor. Todo el sitio viaja dentro del APK y lo
    sirve androidx.webkit WebViewAssetLoader desde el origen HTTPS virtual
    https://appassets.androidplatform.net/ , que nunca sale a la red. Los datos
    del usuario viven en el localStorage del WebView. No hay cuenta remota, ni
    analítica, ni pagos, ni telemetría.

    SUPERFICIE DE ATAQUE: el puente JavaScript. `addJavascriptInterface` expone
    código nativo a cualquier página que se cargue en ese WebView, así que el
    puente SOLO se engancha a contenido servido por el asset loader, es decir al
    origen appassets.androidplatform.net. Cualquier otra URL — un enlace de una
    publicación, la atribución de OpenStreetMap, un wa.me — se abre FUERA, con
    un Intent al navegador o a WhatsApp, nunca dentro del WebView con el puente
    puesto. Si algún día se permite navegar a un host remoto dentro del WebView,
    hay que quitar el puente antes, no añadir el host a esta lista.

    HOSTS REMOTOS LEGÍTIMOS (todos HTTPS, todos opcionales — la app funciona
    entera sin ninguno de ellos):

      · tile.openstreetmap.org   Teselas del mapa de los 18 distritos de
                                 Arequipa. Leaflet pide a.tile / b.tile / c.tile,
                                 de ahí includeSubdomains.
      · images.unsplash.com      Fotos de las publicaciones de demostración que
                                 trae el seed.
      · unpkg.com                Únicamente el respaldo de Leaflet por CDN,
                                 cuando la copia empaquetada no carga.

    NO aparece aquí a propósito:
      · wa.me y www.openstreetmap.org / leafletjs.com — son enlaces que se
        entregan a otra app con un Intent. La petición la hace esa app, no la
        nuestra, así que esta política ni los ve.

    TEXTO PLANO: prohibido en todas partes. `cleartextTrafficPermitted="false"`
    en base-config cubre cualquier host, incluidos los que no estén listados,
    así que un http:// que se cuele en el contenido falla en vez de degradarse
    en silencio.
-->
<network-security-config>

    <!--
        Regla por defecto para TODO el tráfico de la app.
        Solo anclas de confianza del sistema: nada de CAs instaladas por el
        usuario ni por un perfil de trabajo, para que un proxy interceptor
        colocado en el dispositivo no pueda leer ni reescribir lo que pedimos.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Mapa: teselas de OpenStreetMap (a./b./c. son subdominios de tile.). -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tile.openstreetmap.org</domain>
    </domain-config>

    <!-- Fotos de las publicaciones de demostración del seed. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">images.unsplash.com</domain>
    </domain-config>

    <!-- Respaldo de Leaflet por CDN cuando falla la copia empaquetada. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">unpkg.com</domain>
    </domain-config>

    <!--
        Solo para compilaciones depurables (android:debuggable="true"). El
        sistema ignora este bloque por completo en release, así que no hay forma
        de que una CA de usuario acabe siendo de confianza en Play. Está aquí
        para poder mirar el tráfico del mapa con un proxy durante el desarrollo.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
