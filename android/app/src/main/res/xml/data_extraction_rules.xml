<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extracción de datos para API 31+ (android:dataExtractionRules).
    Es la versión moderna de backup_rules.xml y dice deliberadamente LO MISMO:
    si las dos difirieran, la app se comportaría de una forma en Android 11 y de
    otra en Android 12, que es justo el tipo de sorpresa que no queremos.

    El razonamiento completo de por qué SÍ se respalda el localStorage del
    WebView está en backup_rules.xml. Resumen: es el único sitio donde existen
    las publicaciones, los guardados y los mensajes de esta persona; no hay
    credenciales reales que filtrar; y la ubicación guardada es el distrito, no
    una dirección (ADR-007).

    Aquí se separan los dos casos que Android 12 distingue:
      · <cloud-backup>   copia a la nube de Google, que puede quedarse guardada.
      · <device-transfer> paso directo de teléfono viejo a teléfono nuevo, sin
                          intermediarios.
-->
<data-extraction-rules>

    <!--
        Copia a la nube.

        `disableIfNoEncryptionCapabilities="true"` es una decisión conservadora:
        aunque no haya secretos, sí hay publicaciones y conversaciones privadas
        de la persona. Con este atributo la copia solo se hace si el dispositivo
        puede cifrarla de extremo a extremo con el bloqueo de pantalla, de modo
        que ni Google pueda leerla. Si el teléfono no sabe hacerlo, se prefiere
        no subir nada antes que subirlo en claro.
    -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" path="app_webview" />
        <include domain="sharedpref" path="." />

        <exclude domain="root" path="app_webview/Default/GPUCache" />
        <exclude domain="root" path="app_webview/Default/Code Cache" />
        <exclude domain="root" path="app_webview/Default/Service Worker/CacheStorage" />
        <exclude domain="root" path="app_webview/Default/blob_storage" />
    </cloud-backup>

    <!--
        Traspaso directo al teléfono nuevo. No pasa por la nube y la persona lo
        arranca a mano con los dos aparatos delante, así que se incluye lo mismo
        sin condiciones: es el caso en el que más duele perder el foro propio.
    -->
    <device-transfer>
        <include domain="root" path="app_webview" />
        <include domain="sharedpref" path="." />

        <exclude domain="root" path="app_webview/Default/GPUCache" />
        <exclude domain="root" path="app_webview/Default/Code Cache" />
        <exclude domain="root" path="app_webview/Default/Service Worker/CacheStorage" />
        <exclude domain="root" path="app_webview/Default/blob_storage" />
    </device-transfer>

</data-extraction-rules>
