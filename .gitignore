# Notas internas de trabajo: útiles en local, fuera del repositorio
.claude/

# Volcados de fallo de Git Bash: ruido, no forman parte del proyecto
*.stackdump

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Base de datos local del backend
*.db
*.sqlite
*.sqlite3

# Registros
logs/
*.log

# Entorno
.env
.env.local

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Editores
.vscode/
.idea/
*.swp

# --- App Android -----------------------------------------------------------
# Salidas de compilacion y cache de Gradle
android/.gradle/
android/build/
android/app/build/
android/captures/
android/.cxx/

# Rutas y credenciales de esta maquina, nunca del repositorio
android/local.properties
android/keystore.properties
*.jks
*.keystore

# El sitio que viaja dentro de la APK lo genera la tarea syncWebAssets en cada
# build, bajo android/app/build/, que ya queda excluido por la regla de arriba.

# APKs listas para instalar: se regeneran con gradlew, no se versionan
android/dist/
